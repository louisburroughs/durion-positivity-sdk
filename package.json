{
  "name": "durion-positivity-sdk",
  "version": "0.1.0-alpha",
  "private": true,
  "description": "Durion Positivity Backend SDK \u2014 TypeScript client library",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "node scripts/build-workspaces.mjs",
    "typecheck": "tsc --project tsconfig.json",
    "test": "jest",
    "test:integration": "jest --config packages/sdk-integration-tests/jest.integration.config.js --runInBand",
    "populate:shop-floor": "npm run populate:shop-floor -w @durion-sdk/integration-tests",
    "lint": "eslint . --ext .ts,.tsx",
    "generate": "bash scripts/generate-openapi.sh",
    "prune": "node scripts/prune-orphans.mjs",
    "test:accelerated": "jest --config packages/sdk-integration-tests/jest.accelerated.config.js --runInBand",
    "test:accelerated:parity": "jest --config packages/sdk-integration-tests/jest.accelerated.config.js --runInBand --testPathIgnorePatterns=/node_modules/ --testPathIgnorePatterns=z-year-volume",
    "populate:accelerated-year": "npm run populate:accelerated-year -w @durion-sdk/integration-tests"
  },
  "devDependencies": {
    "@openapitools/openapi-generator-cli": "^2.31.1",
    "@types/jest": "^29.5.0",
    "@types/node": "^22.0.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "eslint": "^8.57.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.0",
    "typescript": "~5.9.3"
  }
}
