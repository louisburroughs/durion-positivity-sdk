{
  "name": "@durion-sdk/agent-qa",
  "version": "0.1.0-alpha",
  "private": true,
  "description": "Agentic QA harness: turns every generated SDK operation into an LLM-executable tool and replays a tenant's daily, weekly and monthly operations against a live backend",
  "scripts": {
    "build": "tsc -p tsconfig.json --noEmit",
    "qa": "ts-node src/index.ts",
    "smoke": "ts-node src/smoke/e2eSmoke.ts"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "^3.0.90",
    "@durion-sdk/seeder": "*",
    "@durion-sdk/transport": "*",
    "ai": "^7.0.169",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "ts-node": "^10.9.0",
    "typescript": "~5.9.3"
  }
}
