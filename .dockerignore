# Build context for packages/sdk-seeder/Dockerfile.
#
# Installed and generated artefacts are excluded so the image is built from
# sources only: node_modules is reinstalled inside the image against the
# committed lockfile, and dist/ is regenerated by each workspace's prepare step.
node_modules
**/node_modules
dist
**/dist

.git
.github
.serena
logs
**/*.log

# Nothing that could carry credentials or a local environment into an image
# that is published to a shared registry.
.env
.env.*
*.pem
*.key

# Local tooling and documentation that the seeder does not need at runtime.
.eslintrc.js
jest.config.js
run-seeder.ps1
**/*.md
**/*.test.ts
coverage
