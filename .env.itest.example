# Integration-test credentials for packages/sdk-integration-tests.
#
# Copy to `.env.itest` at the repo root and fill in. `.env.itest` is covered by
# the existing `.env.*` rule in .gitignore and must never be committed.
# Anything already set in the shell takes precedence over this file.
#
# Open the tunnel first:  ./scripts/alpha-itest-tunnel.sh
# Then run:               npm run test:integration

ITEST_BASE_URL=http://localhost:18080
ITEST_SECURITY_SERVICE_URL=http://localhost:18086

# Admin login (SYSTEM_ADMINISTRATOR) — required.
# Alpha seeds `marcus.webb`; the reference seed also has `admin.alpha`.
#
# A bulk-provisioned account sits in an awaiting-activation state: login is
# refused (401 INVALID_CREDENTIALS) until its shared starter password is traded
# through POST /v1/auth/activate-starter for one of its own. This applies per
# account — the admin login and every persona below, separately. The password
# recorded here is the post-activation one, not the starter value. The exchange
# also needs the tenant slug, because localhost does not name a tenant.
# See "Starter credentials must be activated before login" in
# packages/sdk-integration-tests/README.md.
ITEST_USERNAME=
ITEST_PASSWORD=

# Tenants (ALPHA_* required). The tunnel host names no tenant, so every login
# sends ALPHA_TENANT_SLUG and the direct-to-service bootstrap sends
# ALPHA_TENANT_ID as X-Tenant-Id. Global setup stops unless every login is
# bound to it. Both tenants are seeded by pos-tenant V2__seed_tenant.sql.
ALPHA_TENANT_SLUG=alpha
ALPHA_TENANT_ID=01900000-0000-7000-8000-000000000001
# The platform tenant owns the platform tables; suites never run in it.
# Optional, and required only with the platform login.
#PLATFORM_TENANT_SLUG=platform
#PLATFORM_TENANT_ID=01900000-0000-7000-8000-000000000000
#ITEST_PLATFORM_USERNAME=admin.platform
#ITEST_PLATFORM_PASSWORD=

# Shared starter password bulk-loaded accounts (users.csv) hold. When set,
# global setup activates every account whose login is refused and that is
# still awaiting activation,
# setting it to the ITEST_*_PASSWORD recorded here. Accounts that already log
# in are left alone. Activation is one-shot per account.
#ITEST_SEED_PASSWORD=

# Optional per-persona logins (all-or-none per persona). Without these the
# suite runs single-credential mode using the admin login above.
# See "Task 8" in BACKEND_INTERACTION_TEST_SPEC.md for the seeded accounts.
#ITEST_ADVISOR_USERNAME=rachel.kim
#ITEST_ADVISOR_PASSWORD=
#ITEST_TECH_USERNAME=kyle.brennan
#ITEST_TECH_PASSWORD=
#ITEST_MANAGER_USERNAME=diana.rowe
#ITEST_MANAGER_PASSWORD=
#ITEST_ACCT_USERNAME=irene.torres
#ITEST_ACCT_PASSWORD=
#ITEST_PARTS_USERNAME=gloria.mendez
#ITEST_PARTS_PASSWORD=
# CONTROLLER, not ACCOUNT_MANAGER, submits accounting events: backend V25
# (#1499/#1512) rescoped ACCOUNT_MANAGER to customer accounts and moved
# accounting:events:submit here. Suite C9 needs this persona to prove
# enforcement; without it the call falls back to admin and proves nothing.
#ITEST_CONTROLLER_USERNAME=margaret.olsen
#ITEST_CONTROLLER_PASSWORD=

# Forces suite D's staging bin. Leave unset: the suite asks the site for its
# declared staging default and falls back the way StagingLocationResolver does,
# so it follows the backend rather than restating a constant. Set this only to
# pin a specific bin -- putaway generation refuses a receipt held anywhere but
# the resolved staging location.
#ITEST_STAGING_LOCATION_ID=

# Optional determinism / polling knobs.
#ITEST_SEED=1234
#ITEST_WAIT_TIMEOUT_MS=30000
#ITEST_WAIT_INTERVAL_MS=500

# ---------------------------------------------------------------------------
# Accelerated year run (npm run test:accelerated)
#
# Only for a backend on the `accelerated` profile whose clock is anchored a year
# in the past. The normal suites refuse such a backend and vice versa — see
# packages/sdk-integration-tests/README.md, "Accelerated year run".
#
# Every value below is optional; these are the defaults.
# ---------------------------------------------------------------------------

# How much year, and how long you will give it.
#ITEST_ACCEL_DAYS=365
#ITEST_ACCEL_RUN_BUDGET_MS=23400000          # 6h30m; an overrun fails with the date reached
#ITEST_ACCEL_SAMPLE_EVERY=1                  # work every Nth open day; thins intake on a fast clock

# How much work at once. Capped by min(free positions, idle technicians) per site.
#ITEST_ACCEL_CONCURRENCY=8
#ITEST_ACCEL_JOBS_PER_DAY_MIN=4
#ITEST_ACCEL_JOBS_PER_DAY_MAX=12

# When the shop is open. Published to every site the run touches, because
# operating hours cannot be read back from the API.
#ITEST_ACCEL_OPEN_TIME=08:00
#ITEST_ACCEL_CLOSE_TIME=18:00
#ITEST_ACCEL_SATURDAY=09:00-13:00            # or: closed
#ITEST_ACCEL_SUNDAY=closed
#ITEST_ACCEL_HOLIDAYS=                       # comma-separated YYYY-MM-DD; default is the US federal set
#ITEST_ACCEL_PUBLISH_CALENDAR=true
#ITEST_ACCEL_MOBILE_AFTER_HOURS=true         # mobile units take work at any hour
#ITEST_ACCEL_OVERRUN_GRACE_MINUTES=90        # virtual minutes a started job may run past close

# The ledger the run is judged on.
#ITEST_ACCEL_UNPAID_RATIO=0                  # >0 leaves some invoices unpaid, for AR aging
#ITEST_ACCEL_MIN_WORKORDERS=                 # default: 0.6 x jobsPerDay x sampled open days
#ITEST_ACCEL_APPOINTMENT_LEAD_DAYS_MIN=1
#ITEST_ACCEL_APPOINTMENT_LEAD_DAYS_MAX=5

# Clock handling.
#ITEST_ACCEL_POLL_MS=500
#ITEST_ACCEL_MAX_SKEW_MS=60000               # how far virtualTime may exceed the local wall clock

# Run state. The journal lets an interrupted year resume; the lock stops a second
# run starting on this machine. Both are git-ignored.
#ITEST_ACCEL_JOURNAL=.itest-accel-journal.json
#ITEST_ACCEL_LOCK_FILE=                      # default: <journal>.lock
#ITEST_ACCEL_LOCK_URI=                       # the CI workflow's advisory object; logged, not enforced here
