# Dependencies
node_modules/

# Build output
dist/
build/

# Coverage reports
coverage/
.nyc_output/

# TypeScript incremental compile info
*.tsbuildinfo

# TypeScript declaration output files (generated alongside .js by tsc)
**/*.d.ts

# IDE / editor artifacts
.idea/
.vscode/
*.suo
*.user

# OS
.DS_Store
Thumbs.db

# npm/yarn/pnpm lock files for sub-packages (root lock file is tracked)
packages/*/node_modules/
packages/*/dist/

# OpenAPI generator temporary artifacts
.openapi-generator/
# .openapi-generator-ignore is NOT an artifact - it is the only thing stopping
# the generator from overwriting hand-maintained files, so it must be tracked.
!.openapi-generator-ignore

# Environment
.env
.env.local
.env.*
# ...but the credential template is meant to be committed.
!.env.itest.example

# TypeScript project-reference build metadata
*.tsbuildinfo

# Accelerated run journal and its lock (per-run state, never committed).
# Narrow on purpose: a bare *.lock would swallow yarn.lock and friends.
.itest-accel-journal.json
.itest-accel-journal.json.lock
*itest-accel-journal.json
*itest-accel-journal.json.lock
# ...and the journals of past runs, moved aside as <journal>.<realStart>.json by the
# backend's accelerated deploy workflow (or by hand, under any suffix).
.itest-accel-journal.*.json
*itest-accel-journal.*.json

# What the backend's Deploy Alpha (Accelerated Clock) workflow leaves in the alpha host's
# checkout when it starts a run here: the run's log, the pointer to the newest one, and
# the pid it watches.
accelerated-*.log
accelerated-latest.log
.accelerated-run.pid
