# Dependencies
node_modules/

# Build output
dist/
build/

# Coverage reports
coverage/
.nyc_output/

# TypeScript incremental compile info
*.tsbuildinfo

# TypeScript declaration output files (generated alongside .js by tsc)
**/*.d.ts

# IDE / editor artifacts
.idea/
.vscode/
*.suo
*.user

# OS
.DS_Store
Thumbs.db

# npm/yarn/pnpm lock files for sub-packages (root lock file is tracked)
packages/*/node_modules/
packages/*/dist/

# OpenAPI generator temporary artifacts
.openapi-generator/
# .openapi-generator-ignore is NOT an artifact - it is the only thing stopping
# the generator from overwriting hand-maintained files, so it must be tracked.
!.openapi-generator-ignore

# Environment
.env
.env.local
.env.*
# ...but the credential template is meant to be committed.
!.env.itest.example

# TypeScript project-reference build metadata
*.tsbuildinfo
